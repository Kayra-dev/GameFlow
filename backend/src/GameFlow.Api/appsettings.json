{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "GameFlow",
    "Audience": "GameFlowClient",
    "Secret": "",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "FileStorage": {
    "RootPath": "uploads",
    "PublicBasePath": "/uploads",
    "MaxFileSizeBytes": 52428800
  },
  "Seed": {
    "AdminEmail": "admin@gameflow.dev",
    "AdminFullName": "Sistem Yöneticisi",
    "AdminPassword": ""
  },
  "RateLimiting": {
    "LoginPermitPerMinute": 10,
    "RefreshPermitPerMinute": 30,
    "GlobalPermitPerMinute": 300,
    "UploadPermitPerMinute": 30
  },
  "Security": {
    "StorePasswordsAsPlainText": false
  }
}