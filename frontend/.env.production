# Yayın adresi: backend'in internete açık kök adresi
VITE_API_BASE_URL=https://gameflow-api.onrender.com
# GitHub Pages projeyi /<depo-adi>/ altında sunar. CI derlemesinde bu değer
# workflow tarafından depo adından üretilerek geçersiz kılınır; buradaki değer
# yalnızca yerel "npm run build" için geçerlidir.
VITE_BASE_PATH=/GameFlow/
